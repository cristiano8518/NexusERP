# =============================================================================
# NexusERP — Environment Variables (copy to .env and adjust)
# =============================================================================

# --- General ---
DEBUG=1
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL) ---
POSTGRES_DB=nexuserp
POSTGRES_USER=nexuserp
POSTGRES_PASSWORD=nexuserp_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://nexuserp:nexuserp_secret@postgres:5432/nexuserp

# --- Redis ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- Email (development: console backend) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@nexuserp.local

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- External integrations ---
ODOO_EMPLOYEES_URL=
EXTERNAL_API_TIMEOUT_SECONDS=5
EXTERNAL_WEBHOOK_SECRET=dev-webhook-secret
