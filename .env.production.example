# =============================================================================
# NexusERP — Production Environment (copy to .env.production)
# =============================================================================

DEBUG=0
SECRET_KEY=change-this-to-a-very-long-random-production-secret
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,backend
CSRF_TRUSTED_ORIGINS=http://localhost,https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost,https://your-domain.com

POSTGRES_DB=nexuserp
POSTGRES_USER=nexuserp
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://nexuserp:change-this-database-password@postgres:5432/nexuserp

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
THROTTLE_ANON_RATE=30/min
THROTTLE_USER_RATE=180/min
THROTTLE_AUTH_LOGIN_RATE=6/min
THROTTLE_AUTH_REGISTER_RATE=3/min

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=change-this-email-password
DEFAULT_FROM_EMAIL=noreply@example.com

NEXT_PUBLIC_API_URL=/api/v1

ODOO_EMPLOYEES_URL=
EXTERNAL_API_TIMEOUT_SECONDS=5
EXTERNAL_WEBHOOK_SECRET=change-this-webhook-secret

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60
